# ---- KAPE-LUMEN-SETTINGS (install-local.ps1 adds these to vendor/LibreChat/.env) ----
# This file is an EXAMPLE and holds no real values. The real .env is gitignored.

# Branding
APP_TITLE=Kapé Lumen
CUSTOM_FOOTER=Kapé Lumen is a fictional café · SAM10 student project · Built on [LibreChat](https://github.com/danny-avila/LibreChat) (MIT)
HELP_AND_FAQ_URL=/

# Show only our café endpoint (hides OpenAI, Anthropic, Google, etc.)
ENDPOINTS=custom

# Local accounts only
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false

# brew-gateway
# Paste your Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# A random shared token between LibreChat and the gateway (install-local.ps1 generates one)
GATEWAY_TOKEN=
