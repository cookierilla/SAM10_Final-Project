{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"]
      },
      "swap": {
        "measurement": ["swap_used_percent"]
      },
      "disk": {
        "resources": ["/"],
        "measurement": ["used_percent"],
        "drop_device": true
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/kape-bootstrap.log",
            "log_group_name": "/kape/host",
            "log_stream_name": "{instance_id}/bootstrap",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/kape-deploy.log",
            "log_group_name": "/kape/host",
            "log_stream_name": "{instance_id}/deploy",
            "retention_in_days": 14
          },
          {
            "file_path": "/var/log/kape-automation.log",
            "log_group_name": "/kape/host",
            "log_stream_name": "{instance_id}/automation",
            "retention_in_days": 14
          }
        ]
      }
    }
  }
}
