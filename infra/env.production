# Non-secret production settings (committed). render-env.sh combines this file with
# secrets from SSM Parameter Store into /opt/kape/.env on the instance.
# NEVER put a key, password or token in this file.

AWS_REGION=ap-southeast-1
GEMINI_MODEL=gemini-3.5-flash-lite

# Branding
APP_TITLE=Kapé Lumen
CUSTOM_FOOTER=Kapé Lumen is a fictional café · SAM10 student project · Built on [LibreChat](https://github.com/danny-avila/LibreChat) (MIT)
HELP_AND_FAQ_URL=/

# Only our café endpoint
ENDPOINTS=custom

# Local accounts only
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_EMAIL_LOGIN=true

# LibreChat behind Caddy
TRUST_PROXY=1
NODE_ENV=production
